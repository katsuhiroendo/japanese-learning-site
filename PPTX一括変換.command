#!/bin/bash
# -------------------------------------------------------------
# PowerPoint (.pptx) → PDF 一括自動変換 (ダブルクリックで実行)
# -------------------------------------------------------------

cd "$(dirname "$0")"

echo "========================================================"
echo "  📄 PowerPoint資料 → PDF一括変換ツール"
echo "========================================================"
echo "作業フォルダ内のすべての .pptx を検出して slides/ に変換します..."
echo ""

python3 scripts/convert_pptx_to_pdf.py

echo ""
echo "変換処理が完了しました。Enterキーを押すと終了します。"
read -r
